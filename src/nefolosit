#include <avr/io.h>
#include <avr/interrupt.h>

#define D2 2
#define D5 5
#define D6 6
#define D7 7
#define D10 2
#define D11 3
#define D12 4

typedef enum {
    GPIO_INPUT=0,
    GPIO_OUTPUT=1
} GPIO_Dir;

typedef enum {
    GPIO_LOW=0,
    GPIO_HIGH=1
} GPIO_Level;

typedef enum {
    INT_0=0,
    INT_1=1
} ExtInt_Id;

typedef enum {
    EXT_INT_FALLING_EDGE=2,
    EXT_INT_RISING_EDGE=3
} ExtInt_Trigger;

static void (*extint0_callback)(void)=0;
volatile uint8_t press_counter=0;

void GPIO_Init(uint8_t pin,GPIO_Dir dir) {
    if(pin==D10||pin==D11||pin==D12) {
        if(dir==GPIO_OUTPUT) {
            DDRB|=(1<<pin);
        } else {
            DDRB&=~(1<<pin);
        }
    } else {
        if(dir==GPIO_OUTPUT) {
            DDRD|=(1<<pin);
        } else {
            DDRD&=~(1<<pin);
        }
    }
}

void GPIO_Write(uint8_t pin,GPIO_Level level) {
    if(pin==D10||pin==D11||pin==D12) {
        if(level==GPIO_HIGH) {
            PORTB|=(1<<pin);
        } else {
            PORTB&=~(1<<pin);
        }
    } else {
        if(level==GPIO_HIGH) {
            PORTD|=(1<<pin);
        } else {
            PORTD&=~(1<<pin);
        }
    }
}

void ExtInt_Init(ExtInt_Id id,ExtInt_Trigger trigger,void (*callback)(void)) {
    EICRA=(EICRA&0xF3)|(trigger<<ISC00);
    EIMSK|=(1<<INT0);
    extint0_callback=callback;
}

ISR(INT0_vect) {
    if(extint0_callback!=0) {
        extint0_callback();
    }
}

void OnButtonPress(void) {
    press_counter++;
    if(press_counter>2) {
        press_counter=1;
    }
}

int main(void) {
    GPIO_Init(D10,GPIO_OUTPUT);
    GPIO_Init(D11,GPIO_OUTPUT);
    GPIO_Init(D12,GPIO_OUTPUT);
    GPIO_Init(D5,GPIO_OUTPUT);
    GPIO_Init(D6,GPIO_OUTPUT);
    GPIO_Init(D7,GPIO_OUTPUT);
    GPIO_Init(D2,GPIO_INPUT);
    PORTD|=(1<<D2);
    ExtInt_Init(INT_0,EXT_INT_FALLING_EDGE,OnButtonPress);
    sei();
    while(1) {
        if(press_counter==1) {
            GPIO_Write(D10,GPIO_HIGH);
            GPIO_Write(D11,GPIO_HIGH);
            GPIO_Write(D12,GPIO_HIGH);
            GPIO_Write(D5,GPIO_LOW);
            GPIO_Write(D6,GPIO_LOW);
            GPIO_Write(D7,GPIO_LOW);
        } else if(press_counter==2) {
            GPIO_Write(D10,GPIO_LOW);
            GPIO_Write(D11,GPIO_LOW);
            GPIO_Write(D12,GPIO_LOW);
            GPIO_Write(D5,GPIO_HIGH);
            GPIO_Write(D6,GPIO_HIGH);
            GPIO_Write(D7,GPIO_HIGH);
        } else {
            GPIO_Write(D10,GPIO_LOW);
            GPIO_Write(D11,GPIO_LOW);
            GPIO_Write(D12,GPIO_LOW);
            GPIO_Write(D5,GPIO_LOW);
            GPIO_Write(D6,GPIO_LOW);
            GPIO_Write(D7,GPIO_LOW);
        }
    }
    return 0;
}





